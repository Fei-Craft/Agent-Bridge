# Copy to %USERPROFILE%\.agent-bridge\agents.toml and uncomment what you need.
# This file is the machine-local overlay (not the repo default).

[hub]
host = "127.0.0.1"
port = 8765
max_depth = 3

# Opt into a headless worker. ACP remains the bundled default. Restart the hub
# (or local MCP server) after changing protocols; start a NEW session.
# Presets exist for opencode, claude and cursor; no command override is needed.
# [agents.opencode]
# protocol = "cli"  # change back to "acp" to restore the ACP command
# [agents.opencode.cli]
# extra_args = ["--format", "json", "--auto", "--dir", "{cwd}", "--pure"]

# Add any other one-shot CLI without Python code (argv, never a shell template):
# [agents.my_cli]
# protocol = "cli"
# command = ["my-cli"]
# revivable = true
# [agents.my_cli.cli]
# parser = "jsonl"  # text | jsonl | claude | opencode | cursor
# prompt_args = ["-p", "{prompt}"]
# prompt_stdin = false  # for stdin: true AND prompt_args = []
# resume_args = ["--resume", "{session}"]
# model_args = ["--model", "{model}"]
# effort_args = ["--effort", "{effort}"]
# extra_args = ["--output-format", "jsonl"]

# Behind a firewall only. A machine on a direct network needs no proxy;
# a null env.proxy in list_agents is normal there.
# [env.proxy]
# url = "http://127.0.0.1:7897"
# no_proxy = "localhost,127.0.0.1,::1"

# Optional idle self-exit; enable only when the host can reconnect reliably.
# Disabled by default (0); a positive value opts into idle server shutdown.
# [server]
# idle_exit_sec = 7200

# Cancel a turn whose worker has produced no output for this long (seconds).
# Default 1800; 0 disables. Raise it for a worker that runs long silent
# builds or test suites. The task then ends failed / stop_reason "stalled".
# turn_timeout_sec instead caps a turn's wall-clock regardless of output
# (default 0 = off; timeout ends failed / "timed_out").
# [agents.grok]
# stall_timeout_sec = 3600
# turn_timeout_sec = 7200

# How Bridge answers ACP permission prompts: allow_once (default, least
# privilege), allow_always, or deny. Under allow_once a prompt that offers
# only allow-always is denied.
# [agents.grok]
# permission_policy = "allow_always"

# Dispatch policy: mode = manual | auto | eager (default auto).
# instructions is free text the coordinator reads via list_agents; it
# overrides the default worker split and persists across sessions.
# [coordinator]
# mode = "auto"
# instructions = """Research goes to antigravity. Coding goes to grok.
# Long single-file ports go to kimi (k3-256k)."""

# Remaining quota returned with each list_agents row (agents[].quota).
# Bridge only reports it; routing stays with the coordinator and your
# instructions. Workers Bridge cannot query answer status = "unknown".
# Custom API/auth endpoints are unsupported; cache expires at window reset.
# DSH balance lookup is unsupported.
# experimental = true also reads the private endpoints Grok Build's and
# Claude Code's own /usage commands call (OAuth login only).
# [quota]
# enabled = true
# timeout_sec = 4
# cache_sec = 300
# experimental = false

# Optional. Only if a worker actually reads that variable from the process
# environment. DSH credentials usually live in ~/.dsh/.credentials.yaml.
# [env.set]
# DEEPSEEK_API_KEY = "do-not-commit"

# Remove worker env keys matching these globs. Keys set via [env.set] or
# the agent's own env always survive; there is no built-in denylist.
# [env]
# deny = ["AWS_*", "DATABASE_URL"]

# [agents.grok.env]
# HTTPS_PROXY = "http://127.0.0.1:7897"

# OpenCode: no product login. Connect providers with `opencode auth`
# (official Zen / Go, or any API-key provider). Optional passthrough:
# [env.set]
# OPENCODE_API_KEY = "do-not-commit"

# Kimi: auth lives in ~/.kimi-code (run `kimi login` once), not in an env var.
# Only pin these when the defaults are wrong for this machine:
# [agents.kimi.env]
# KIMI_CODE_HOME = "D:/kimi-code"
# KIMI_SHELL_PATH = "C:/Program Files/Git/bin/bash.exe"

# Claude Code: product `claude` is not ACP. Install the adapter and log in:
#   npm install -g @agentclientprotocol/claude-agent-acp @anthropic-ai/claude-code
#   claude auth login
# Gateway / OpenRouter (optional) — ANTHROPIC_API_KEY must stay empty:
# [env.set]
# ANTHROPIC_BASE_URL = "https://openrouter.ai/api"
# ANTHROPIC_AUTH_TOKEN = "do-not-commit"
# CLAUDE_CODE_ENABLE_GATEWAY_MODEL_DISCOVERY = "1"
# OPENROUTER_API_KEY is also inherited; if ANTHROPIC_AUTH_TOKEN is unset,
# Bridge copies it and defaults the base URL to OpenRouter.

# ZCode: product `zcode` is not ACP. Install the adapter and sign in via the app:
#   npm install -g zcode-acp-server
# Optional when the CLI is not on PATH:
# [env.set]
# ZCODE_BIN = "C:/Program Files/ZCode/resources/glm/zcode.cjs"
# ZCODE_HOME = "D:/zcode-home"

# MiniMax Code: `mcode acp`. Auth is `mcode login` under ~/.minimax.
#   npm install -g @minimax-ai/code
# [env.set]
# MINIMAX_DATA_DIR = "D:/minimax"

# Cloud API workers (uncomment complete blocks; no local command required).
# Optional cloud-to-local access uses a SEPARATE loopback-only gateway. Never tunnel admin 8765.
# [hub.remote]
# enabled = false
# host = "127.0.0.1"
# port = 8766
# remote_callable_agents = ["opencode"]
# remote_workspaces = { project = "/absolute/trusted/project" }
# # token_ttl_sec = 86400 # omitted: cloud agent's turn_timeout_sec (24h if disabled)
# result_fetch_grace_sec = 30
# max_calls_per_token = 16
# max_concurrent_per_token = 2
# rate_limit_per_min = 60
# max_body_bytes = 65536
# require_approval = true # default; local approval required before execution
# public_url = "https://your-gateway.example.com"
# access_note = "Supply Cloudflare Access service-token headers via your cloud secret store."
# require_cf_access = true # header presence; validate JWT/service token at Cloudflare Access edge

# Use `agent-bridge secrets set cursor` / `set devin`, then restart the hub.
# Explicit environment fallback warns; never store keys in this file.
# [agents.cursor-cloud]
# protocol = "cloud"
# stall_timeout_sec = 0
# turn_timeout_sec = 86400
# [agents.cursor-cloud.cloud]
# provider = "cursor"
# api_key_env = "CURSOR_API_KEY"
# base_url = "https://api.cursor.com"
# repo = "https://github.com/org/repo"
# ref = "main"
# auto_create_pr = true
# model = "composer-2"
# poll_interval_sec = 5
#
# [agents.devin-cloud]
# protocol = "cloud"
# [agents.devin-cloud.cloud]
# provider = "devin"
# api_key_env = "DEVIN_API_KEY"
# base_url = "https://api.devin.ai"
# org_id_env = "DEVIN_ORG_ID"
# # org_id = "org-your-org" # alternatively set a non-secret org ID here
# repo = "https://github.com/org/repo"
# ref = "main" # prompt instruction; Devin has no dedicated checkout-ref field
# devin_mode = "fast" # --model, then --effort, overrides this on creation
# max_acu_limit = 5 # cumulative session ACUs, not tokens
# poll_interval_sec = 5
# # Cancel/end_session terminates Devin permanently; start a new session afterward.
# # Hub shutdown/idle unload leave cloud work running and provider billing active.

# DSH: do not put a personal checkout path in the repo agents.toml.
# Optional overrides live here or in the process environment:
# DSH_ACP_BIN = "C:/path/to/dsh-acp-demo/lib/bin.js"
# DSH_HARNESS = "C:/src/deepseek-harness"
